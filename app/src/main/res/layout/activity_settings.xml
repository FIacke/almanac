<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1621"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#17212B"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="80dp" android:layout_height="80dp"
                android:background="#5288C1" android:gravity="center"
                android:text="A" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Andriyan"
                android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileId"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="ID: user_12345"
                android:textColor="#8B9BA5" android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingTop="16dp" android:paddingBottom="8dp"
            android:text="НАСТРОЙКИ" android:textColor="#5288C1" android:textSize="12sp" android:textStyle="bold" />

        <Switch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="Уведомления" android:textColor="#FFFFFF" android:textSize="16sp" />

        <Switch
            android:id="@+id/switchSounds"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="Звуки" android:textColor="#FFFFFF" android:textSize="16sp" />

        <Switch
            android:id="@+id/switchMediaAuto"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="Автозагрузка медиа" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
